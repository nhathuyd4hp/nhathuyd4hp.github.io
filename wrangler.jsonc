// Cloudflare Worker that serves the portfolio as static assets (no server code).
// Deploy: `npx wrangler deploy`, or push to main and let .github/workflows/cloudflare.yml do it.
{
  "name": "portfolio",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./portfolio",
    "not_found_handling": "single-page-application",
  },
}
